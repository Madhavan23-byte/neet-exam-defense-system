# B-SEA Environment Configuration Template (Phase 3C-1)
# ──────────────────────────────────────────────────────────────────────────────
# NEVER commit the actual .env file or real secrets to version control.
# Copy to .env and fill in values for your target deployment tier.
#
# ENVIRONMENT TIERS:
# 1. Development:              ENVIRONMENT=development
# 2. Testing:                  ENVIRONMENT=testing
# 3. Local Production-Parity:  ENVIRONMENT=production-local
# 4. AWS Cloud Staging:        ENVIRONMENT=staging-aws
# ──────────────────────────────────────────────────────────────────────────────

# ── Application Configuration ─────────────────────────────────────────────────
ENVIRONMENT=production-local
APP_NAME=B-SEA
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8000
GUNICORN_WORKERS=4

# ── Database Configuration ────────────────────────────────────────────────────
# PostgreSQL (Local Production-Parity & Staging):
DATABASE_URL=postgresql+asyncpg://bsea_user:bsea_dev_password_change_me@localhost:5432/bsea_db
SYNC_DATABASE_URL=postgresql+psycopg2://bsea_user:bsea_dev_password_change_me@localhost:5432/bsea_db

# SQLite (Local lightweight development fallback only):
# DATABASE_URL=sqlite+aiosqlite:///./bsea_demo.db
# SYNC_DATABASE_URL=sqlite:///./bsea_demo.db

# ── Database Connection Pool (PostgreSQL / RDS Proxy) ─────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis State & Distributed Rate Limiting ───────────────────────────────────
REDIS_URL=redis://:bsea_redis_pass@localhost:6379/0
REDIS_SESSION_TTL=7200
REDIS_RATE_LIMIT_TTL=60

# Rate limiting storage override (leave unset for default auto-detection):
# BSEA_RATE_LIMIT_STORAGE=redis://:bsea_redis_pass@localhost:6379/0

# ── Performance / Benchmarking Mode ───────────────────────────────────────────
# Relaxes rate limit quotas for infrastructure load/stress testing only:
BSEA_BENCHMARK_MODE=false

# ── JWT / Authentication ──────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MINIMUM_64_CHARACTERS_LONG_SECRET_KEY_abc123
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cryptographic Key Management Service ──────────────────────────────────────
# Phase 3C-1 uses MockKMS locally. AWS KMS will be enabled in Phase 3C-3.
KMS_PROVIDER=mock
MOCK_KMS_MASTER_KEY=bsea_kms_master_key_change_me_32ch
MOCK_KMS_SIGNING_KEY=bsea_ed25519_seed_32_bytes_change_

# ── Object Storage (S3 / MinIO) ───────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=bsea_minio_access
MINIO_SECRET_KEY=bsea_minio_secret_change_me
MINIO_SECURE=false

# ── CORS Settings ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
