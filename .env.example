# B-SEA Environment Configuration Example
# ──────────────────────────────────────────────────────────────────────────────
# NEVER commit the actual .env file to version control.
# Copy to .env and fill in values for your environment.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (Production/Staging):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bsea
# SQLite (Local Development fallback):
# DATABASE_URL=sqlite+aiosqlite:///./bsea_demo.db

# ── Connection Pool ─────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT / Application Security ───────────────────────────────────────────────
SECRET_KEY=change-me

# ── MockKMS Configuration ────────────────────────────────────────────────────
# PROTOTYPE ONLY. Production uses Cloud KMS / HSM.
KMS_MODE=mock
MOCK_KMS_MASTER_KEY=bsea_kms_master_key_change_me_xx
MOCK_KMS_SIGNING_KEY=bsea_ed25519_seed_32_bytes_change

# ── Performance / Benchmarking ──────────────────────────────────────────────
# Disable rate limiting for infrastructure stress testing
BSEA_BENCHMARK_MODE=false
